         name="EON PVR Client"
         version="21.7.9"
         provider-name="Davor Dragic"
         minversion="21.0.0">
    <requires>
      <import addon="xbmc.pvr" version="7.0.0" />
    </requires>
    <extension point="xbmc.pvrclient" library_linux_armv7="pvr.eon.so" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en">EON PVR Client</summary>
      <description lang="en">Watch TV using EON PVR addon.</description>
      <platform>linux-armv7</platform>
      <url>https://davordragic.github.io/kodi-repo/21.2.0/pvr.eon-21.7.9-linux-armv7a.zip</url>
    </extension>
  </addon>
</addons>
