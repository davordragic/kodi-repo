<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.davor"
       name="Davor's Kodi Repo"
       version="0.1.0"
       provider-name="Davor">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Davor's Kodi Repo">
    <dir>
      <info>https://davordragic.github.io/kodi-repo/addons.xml</info>
      <checksum>https://davordragic.github.io/kodi-repo/addons.xml.md5</checksum>
      <datadir>https://davordragic.github.io/kodi-repo/addons/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Repository for my personal Kodi add-ons</summary>
    <description lang="en">Auto-updates of the plugins I use</description>
    <platform>all</platform>
  </extension>
</addon>
