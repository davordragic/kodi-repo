<addon id="repository.kodi"
       name="Davor's Kodi Repo"
       version="0.1.0"
       provider-name="Davor Dragic">

  <extension point="xbmc.addon.repository">
    <dir info="https://davordragic.github.io/kodi-repo/addons.xml"
         checksum="https://davordragic.github.io/kodi-repo/addons.xml.md5"
         content="all"
         platform="all" />
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary lang="en">Davor's Kodi Addons</summary>
    <description lang="en">Install and update addons from Davor's repository.</description>
    <platform>all</platform>
  </extension>
</addon>
